# Copy to .env and fill in values. Run: npm run setup

# Required
MONGO_URI=mongodb://127.0.0.1:27017/bachat
JWT_SECRET=change_this_to_a_long_random_string

# Server
PORT=3000
NODE_ENV=development

# Optional: comma-separated browser origins (empty = allow all in dev)
# CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Public URL used in emails (optional)
# PUBLIC_APP_URL=http://localhost:3000

# Email (optional — without these, OTP is logged to console in dev)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Bachat <no-reply@example.com>"

# Razorpay (optional until you take payments)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Orders / pricing (optional)
# PLATFORM_FEE_FLAT=0
# PRICE_MARKUP_SECRET=change_me_in_production

# create-admin.js defaults (optional)
# ADMIN_EMAIL=admin@bachat.local
# ADMIN_PASSWORD=
# ADMIN_NAME=Ops Admin
