# Copy to .env and fill in values. Run: npm run setup

# Required
MONGO_URI=mongodb://127.0.0.1:27017/bachat
JWT_SECRET=change_this_to_a_long_random_string

# Server
PORT=3000
NODE_ENV=development

# Production: set NODE_ENV=production and set CORS_ORIGIN to your real HTTPS origins (comma-separated).
# Optional: comma-separated browser origins (empty = allow all in dev — do NOT ship that way in prod)
# CORS_ORIGIN=https://app.yourdomain.com,https://www.yourdomain.com

# Dev only: if "1", login/register/resend responses may include dev_otp for local testing. Leave unset in production.
# EXPOSE_DEV_OTP=1

# Public URL used in emails and OAuth redirects (recommended)
# PUBLIC_APP_URL=http://localhost:3000

# Mobile on profile is confirmed via email (POST /api/auth/phone-otp/request sends a code to the account email).
# Configure SMTP so users receive the code; without SMTP, the message is logged to the server console in dev.

# Optional: Twilio SMS (not used for buyer phone verify today; reserved for other features)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1234567890

# Email — OTP, phone confirmation, notifications (recommended; without SMTP, mail is logged in dev)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Bachat <no-reply@example.com>"
# (EMAIL_FROM is also accepted)

# Razorpay (optional until you take payments)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Orders / pricing (optional)
# PLATFORM_FEE_FLAT=0
# PRICE_MARKUP_SECRET=change_me_in_production

# Team accounts (/team-login.html — Sales / Ops / Admin). Not read by the server at runtime.
# Upsert all three in MongoDB after any change:
#   npm run sync-team
# ADMIN_EMAIL=admin@bachat.local
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
# ADMIN_CITY=Indore
# ADMIN_REGION=Madhya Pradesh
# ADMIN_PHONE=9876543210
#
# OPS_EMAIL=ops@bachat.local
# OPS_PASSWORD=
# OPS_NAME=Operations
# OPS_CITY=Indore
# OPS_REGION=MP
#
# SALES_EMAIL=sales@bachat.local
# SALES_PASSWORD=
# SALES_NAME=Field Sales
# SALES_CITY=Indore
# SALES_REGION=MP
# SALES_PHONE=

# Delivery drivers (create-delivery.js) — optional
# DELIVERY_EMAIL=driver@bachat.local
# DELIVERY_PASSWORD=
# DELIVERY_NAME=Delivery Partner
# DELIVERY_CITY=Indore
# DELIVERY_REGION=Madhya Pradesh
# DELIVERY_PHONE=9876543210

# Delivery pool: minutes before an unclaimed job expires (then seller can re-offer)
# DELIVERY_CLAIM_TIMEOUT_MINUTES=15
# Driver GPS update throttling + route retention
# DELIVERY_GPS_MIN_GAP_MS=5000
# DELIVERY_GPS_RATE_WINDOW_MS=10000
# DELIVERY_GPS_RATE_MAX_HITS=4
# DELIVERY_ROUTE_RETENTION_DAYS=7
# DELIVERY_ROUTE_MAX_POINTS=1200
# DELIVERY_ROUTE_CLEANUP_INTERVAL_MIN=60

# In production, leave unset so delivery KYC requires admin approval after Aadhaar last-4 submit.
# Set to 1 with NODE_ENV=production only if you accept auto-approval (not recommended).
# DELIVERY_KYC_AUTO_VERIFY=1

# =============================================================================
# Live shopkeeper KYC — closing the UIDAI gap (no “secret” fix in code alone)
# =============================================================================
#
# UIDAI OTP / XML eKYC is not available as a DIY HTTP API. Only UIDAI-registered
# Authentication Service Providers (ASPs) get production access. To “fix” that
# limitation you must: (1) contract an ASP / KYC vendor, (2) complete their onboarding
# (agreements, templates, audits as they require), (3) then either redirect sellers
# through their hosted flow or add server routes that call their API (we can wire
# Bachat to a specific vendor once you choose one and share API docs).
#
# What you can enable in Bachat today without UIDAI direct access:
#   • DigiLocker / Meri Pehchaan — partner app + env vars below; sellers use
#     `/seller-kyc.html` → DigiLocker (issued-document metadata).
#   • GST — `POST /api/seller/kyc/verify-gst` checks format + checksum; optional
#     `GST_REGISTRY_LOOKUP_*` points at YOUR HTTPS proxy (GSP / vendor / n8n).
#   • Ops still approve in `/admin-seller-kyc.html` if policy requires human sign-off.
#
# =============================================================================

# --- DigiLocker / Meri Pehchaan (optional) ---
# Partner registration (production): env vars alone are NOT “go live”. You must register your
# application on the partner portal (see https://dlpartners.meripehchaan.gov.in/), obtain
# client_id / client_secret, register redirect URIs (HTTPS in production), complete testing or
# audit steps the portal requires, and align with MeitY / API Setu rules for your use case.
#
# OAuth (Authorized Partner flow): when all three are set, delivery KYC and shopkeeper `/seller-kyc.html` show DigiLocker.
# Callback sets digilocker_linked_at and keeps a short-lived in-memory access token so the
# browser can call POST /api/digilocker/pull-issued-meta (issued-document metadata only).
# DIGILOCKER_CLIENT_ID=
# DIGILOCKER_CLIENT_SECRET=
# DIGILOCKER_REDIRECT_URI=http://localhost:3000/api/digilocker/callback
# Authorization scope sent to /authorize (empty string = omit; default openid per spec for id_token).
# DIGILOCKER_OAUTH_SCOPE=openid
#
# Legal / data: define purpose, notices, retention, and whether DigiLocker counts as KYC with
# counsel before enabling downloads. Binary/XML file fetch is OFF unless:
# DIGILOCKER_ALLOW_FILE_FETCH=1
# DIGILOCKER_FETCH_MAX_BYTES=2097152

# Team TOTP MFA — encrypts stored secrets (falls back to JWT_SECRET if unset in dev).
# MFA_ENCRYPTION_KEY=another_long_random_string

# Team OIDC (optional). When OIDC_ISSUER + OIDC_CLIENT_ID + OIDC_REDIRECT_URI are set,
# GET /api/auth/oidc/team/start begins login; callback issues a short-lived handoff for team-login.html.
# Must match the IdP app registration (HTTPS in production).
# OIDC_ISSUER=https://your-idp.example.com/realms/your-realm
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/team/callback
# OIDC_SCOPES=openid email profile

# --- Shopkeeper GST “live” registry (optional) ---
# POST /api/seller/kyc/verify-gst always validates format + 15th-digit checksum on the server.
# For government registry status, point to YOUR HTTPS proxy that returns JSON (e.g. MasterGST / ASP).
# URL must include the literal substring {gstin} — we perform GET and parse common fields (lgnm, sts, active, valid).
# GST_REGISTRY_LOOKUP_URL=https://your-api.example.com/registry/gst/{gstin}
# GST_REGISTRY_LOOKUP_BEARER=your_service_token
# GST_REGISTRY_LOOKUP_TIMEOUT_MS=12000

# Shopkeeper eKYC: sellers complete `/seller-kyc.html`; ops queue at `/admin-seller-kyc.html` (API: `/api/admin/seller-kyc/*`).

# Smoke tests: npm run test (requires API running unless SKIP_API_TESTS=1)
# TEST_API_URL=http://127.0.0.1:3000
# SKIP_API_TESTS=0
