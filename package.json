{
  "name": "bachat",
  "version": "0.1.0",
  "private": true,
  "description": "Bachat — request-quote-order marketplace API",
  "main": "src/index.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node src/index.js",
    "dev:watch": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node scripts/migrate.js",
    "normalize-locations": "node scripts/normalize-locations.js",
    "create-admin": "node scripts/create-admin.js",
    "create-sales": "node scripts/create-sales.js",
    "sync-team": "node scripts/sync-team-users.js",
    "create-delivery": "node scripts/create-delivery.js",
    "test": "node --test test/*.mjs",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/assets/tailwind.css --minify",
    "qa:browser": "node scripts/browser-qa.mjs",
    "check:deployment": "node scripts/check-deployment-readiness.mjs",
    "mobile:prepare": "node scripts/prepare-mobile-web.js",
    "mobile:sync": "npm run mobile:prepare && npx cap sync",
    "mobile:android:bundle": "npm run mobile:sync && cd android && gradlew.bat bundleRelease",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "nodemailer": "^6.9.15",
    "openid-client": "^5.7.1",
    "otplib": "^12.0.1",
    "razorpay": "^2.9.4"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@playwright/test": "^1.60.0",
    "tailwindcss": "^3.4.17"
  }
}
